# Development mode: logs extra details, never exposes secrets in HTTP responses
WORK_DEV=false

# HTTP server
WORK_HOST=localhost
WORK_PORT=8001

# STUN server (WebRTC), UDP
# WORK_STUN_PORT=3478

# HTTPS (optional)
# WORK_TLSHOST=localhost
# WORK_TLS_PORT=8443
# WORK_TLS_CERT=/path/to/cert.pem
# WORK_TLS_KEY=/path/to/key.pem

# Auth challenge lifetime (ms), default 5 minutes
# WORK_CHALLENGE_TTL_MS=300000

# Optional AI API token (genApi)
# WORK_GEN_API_TOKEN=

# Agent log level: debug | info | warn (default warn). debug — показывает, что молча глотали пустые catch
# WORK_LOG=debug

# WORK as an MCP server for external AI clients (OpenCode, Claude Code): POST /mcp, localhost/LAN only. 0 — disable.
# WORK_MCP=0

# Key for encrypting user secrets on disk (connections tokens), 32 bytes: 64 hex chars or base64.
# Optional: without it the key is derived from #system/node-key.json (keep that file in backups!).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WORK_SECRET_KEY=

# GigaChat Authorization key (fallback, if MODELS/GigaChat/$provider/#secret/gigachat.json is absent)
# GIGACHAT_KEY=
