            "content": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Сапёр</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody {\n  font-family: 'Segoe UI', Tahoma, sans-serif;\n  background: #1a1a2e;\n  color: #eee;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  min-height: 100vh;\n  padding: 20px;\n  overflow-x: hidden;\n}\nh1 { margin-bottom: 10px; font-size: 1.8em; color: #e94560; }\n.controls {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 15px;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n.controls button {\n  padding: 8px 16px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 0.9em;\n  background: #16213e;\n  color: #eee;\n  transition: background 0.2s;\n}\n.controls button:hover { background: #0f3460; }\n.controls button.active { background: #e94560; }\n.status-bar {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  margin-bottom: 15px;\n  font-size: 1.1em;\n}\n.status-bar .counter {\n  background: #16213e;\n  padding: 6px 14px;\n  border-radius: 6px;\n  font-family: monospace;\n  font-size: 1.2em;\n}\n#reset-btn {\n  font-size: 1.8em;\n  cursor: pointer;\n  background: #16213e;\n  border: none;\n  border-radius: 8px;\n  padding: 4px 10px;\n  transition: transform 0.1s;\n}\n#reset-btn:active { transform: scale(0.9); }\n#board {\n  display: grid;\n  gap: 2px;\n  background: #0f3460;\n  padding: 6px;\n  border-radius: 8px;\n  user-select: none;\n}\n.cell {\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: bold;\n  font-size: 0.95em;\n  cursor: pointer;\n  background: #16213e;\n  border-radius: 4px;\n  transition: background 0.1s;\n}\n.cell:hover { background: #1a3a5c; }\n.cell.revealed {\n  background: #0d1b2a;\n  cursor: default;\n}\n.cell.revealed:hover { background: #0d1b2a; }\n.cell.flagged { background: #1a3a5c; }\n.cell.mine { background: #e94560; }\n.cell.n1 { color: #4fc3f7; }\n.cell.n2 { color: #81c784; }\n.cell.n3 { color: #e57373; }\n.cell.n4 { color: #ba68c8; }\n.cell.n5 { color: #ffb74d; }\n.cell.n6 { color: #4dd0e1; }\n.cell.n7 { color: #f06292; }\n.cell.n8 { color: #aed581; }\n#message {\n  margin-top: 15px;\n  font-size: 1.3em;\n  min-height: 1.5em;\n  font-weight: bold;\n}\n#message.win { color: #81c784; }\n#message.lose { color: #e94560; }\n#fireworks-canvas {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 9999;\n}\n</style>\n</head>\n<body>\n<canvas id=\"fireworks-canvas\"></canvas>\n<h1>💣 Сапёр</h1>\n<div class=\"controls\">\n  <button data-level=\"beginner\" class=\"active\">Новичок 9×9</button>\n  <button data-level=\"intermediate\">Средний 16×16</button>\n  <button data-level=\"expert\">Эксперт 16×30</button>\n</div>\n<div class=\"status-bar\">\n  <span class=\"counter\" id=\"mine-counter\">10</span>\n  <button id=\"reset-btn\">🙂</button>\n  <span class=\"counter\" id=\"timer\">0</span>\n</div>\n<div id=\"board\"></div>\n<div id=\"message\"></div>\n\n<script>\nconst LEVELS = {\n  beginner:     { rows: 9,  cols: 9,  mines: 10 },\n  intermediate: { rows: 16, cols: 16, mines: 40 },\n  expert:       { rows: 16, cols: 30, mines: 99 }\n};\n\nlet level = 'beginner';\nlet rows, cols, totalMines;\nlet board = [];\nlet revealed = [];\nlet flagged = [];\nlet mines = [];\nlet firstClick = true;\nlet gameOver = false;\nlet revealedCount = 0;\nlet timerInterval = null;\nlet seconds = 0;\n\nconst boardEl = document.getElementById('board');\nconst mineCounterEl = document.getElementById('mine-counter');\nconst timerEl = document.getElementById('timer');\nconst resetBtn = document.getElementById('reset-btn');\nconst messageEl = document.getElementById('message');\n\nfunction init() {\n  const cfg = LEVELS[level];\n  rows = cfg.rows; cols = cfg.cols; totalMines = cfg.mines;\n  board = []; revealed = []; flagged = []; mines = [];\n  firstClick = true; gameOver = false; revealedCount = 0; seconds = 0;\n  timerEl.textContent = '0';\n  mineCounterEl.textContent = totalMines;\n  resetBtn.textContent = '🙂';\n  messageEl.textContent = '';\n  messageEl.className = '';\n  clearInterval(timerInterval);\n  timerInterval = null;\n  stopFireworks();\n\n  for (let r = 0; r < rows; r++) {\n    board[r] = []; revealed[r] = []; flagged[r] = [];\n    for (let c = 0; c < cols; c++) {\n      board[r][c] = 0;\n      revealed[r][c] = false;\n      flagged[r][c] = false;\n    }\n  }\n  render();\n}\n\nfunction placeMines(safeR, safeC) {\n  const safe = new Set();\n  for (let dr = -1; dr <= 1; dr++)\n    for (let dc = -1; dc <= 1; dc++)\n      safe.add((safeR + dr) + ',' + (safeC + dc));\n\n  let placed = 0;\n  while (placed < totalMines) {\n    const r = Math.floor(Math.random() * rows);\n    const c = Math.floor(Math.random() * cols);\n    if (safe.has(r + ',' + c) || board[r][c] === -1) continue;\n    board[r][c] = -1;\n    mines.push([r, c]);\n    placed++;\n  }\n  for (let r = 0; r < rows; r++)\n    for (let c = 0; c < cols; c++)\n      if (board[r][c] !== -1)\n        board[r][c] = countAdjacent(r, c);\n}\n\nfunction countAdjacent(r, c) {\n  let n = 0;\n  for (let dr = -1; dr <= 1; dr++)\n    for (let dc = -1; dc <= 1; dc++) {\n      if (dr === 0 && dc === 0) continue;\n      const nr = r + dr, nc = c + dc;\n      if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && board[nr][nc] === -1) n++;\n    }\n  return n;\n}\n\nfunction reveal(r, c) {\n  if (r < 0 || r >= rows || c < 0 || c >= cols) return;\n  if (revealed[r][c] || flagged[r][c]) return;\n  revealed[r][c] = true;\n  revealedCount++;\n  if (board[r][c] === 0) {\n    for (let dr = -1; dr <= 1; dr++)\n      for (let dc = -1; dc <= 1; dc++)\n        reveal(r + dr, c + dc);\n  }\n}\n\nfunction handleClick(r, c) {\n  if (gameOver || flagged[r][c]) return;\n  if (firstClick) {\n    firstClick = false;\n    placeMines(r, c);\n    startTimer();\n  }\n  if (board[r][c] === -1) {\n    lose(r, c);\n    return;\n  }\n  reveal(r, c);\n  checkWin();\n  render();\n}\n\nfunction handleRightClick(e, r, c) {\n  e.preventDefault();\n  if (gameOver || revealed[r][c]) return;\n  flagged[r][c] = !flagged[r][c];\n  const flagCount = flagged.flat().filter(Boolean).length;\n  mineCounterEl.textContent = totalMines - flagCount;\n  render();\n}\n\nfunction startTimer() {\n  timerInterval = setInterval(() => {\n    seconds++;\n    timerEl.textContent = seconds;\n  }, 1000);\n}\n\nfunction lose(hitR, hitC) {\n  gameOver = true;\n  clearInterval(timerInterval);\n  resetBtn.textContent = '😵';\n  messageEl.textContent = '💥 Бум! Попробуй ещё раз.';\n  messageEl.className = 'lose';\n  for (const [mr, mc] of mines) {\n    revealed[mr][mc] = true;\n    if (mr === hitR && mc === hitC) board[mr][mc] = -2;\n  }\n  render();\n}\n\nfunction checkWin() {\n  if (revealedCount === rows * cols - totalMines) {\n    gameOver = true;\n    clearInterval(timerInterval);\n    resetBtn.textContent = '😎';\n    messageEl.textContent = '🎉 Победа! Время: ' + seconds + 'с';\n    messageEl.className = 'win';\n    startFireworks();\n  }\n}\n\nfunction render() {\n  boardEl.style.gridTemplateColumns = `repeat(${cols}, 32px)`;\n  boardEl.innerHTML = '';\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < cols; c++) {\n      const cell = document.createElement('div');\n      cell.className = 'cell';\n      if (revealed[r][c]) {\n        cell.classList.add('revealed');\n        if (board[r][c] === -1 || board[r][c] === -2) {\n          cell.classList.add('mine');\n          cell.textContent = '💣';\n        } else if (board[r][c] > 0) {\n          cell.classList.add('n' + board[r][c]);\n          cell.textContent = board[r][c];\n        }\n      } else if (flagged[r][c]) {\n        cell.classList.add('flagged');\n        cell.textContent = '🚩';\n      }\n      cell.addEventListener('click', () => handleClick(r, c));\n      cell.addEventListener('contextmenu', (e) => handleRightClick(e, r, c));\n      boardEl.appendChild(cell);\n    }\n  }\n}\n\n// === Салют ===\nconst canvas = document.getElementById('fireworks-canvas');\nconst ctx = canvas.getContext('2d');\nlet fireworksActive = false;\nlet fireworksRAF = null;\nlet particles = [];\nlet rockets = [];\nlet lastLaunch = 0;\n\nfunction resizeCanvas() {\n  canvas.width = window.innerWidth;\n  canvas.height = window.innerHeight;\n}\nwindow.addEventListener('resize', resizeCanvas);\nresizeCanvas();\n\nfunction startFireworks() {\n  fireworksActive = true;\n  particles = [];\n  rockets = [];\n  lastLaunch = 0;\n  if (fireworksRAF) cancelAnimationFrame(fireworksRAF);\n  fireworksLoop();\n}\n\nfunction stopFireworks() {\n  fireworksActive = false;\n  if (fireworksRAF) {\n    cancelAnimationFrame(fireworksRAF);\n    fireworksRAF = null;\n  }\n  particles = [];\n  rockets = [];\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n}\n\nfunction launchRocket() {\n  const x = canvas.width * 0.15 + Math.random() * canvas.width * 0.7;\n  const targetY = canvas.height * 0.15 + Math.random() * canvas.height * 0.3;\n  rockets.push({\n    x: x,\n    y: canvas.height,\n    targetY: targetY,\n    speed: 4 + Math.random() * 3,\n    hue: Math.random() * 360,\n    trail: []\n  });\n}\n\nfunction explodeRocket(rocket) {\n  const count = 60 + Math.floor(Math.random() * 40);\n  for (let i = 0; i < count; i++) {\n    const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.3;\n    const speed = 2 + Math.random() * 4;\n    particles.push({\n      x: rocket.x,\n      y: rocket.targetY,\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed,\n      hue: rocket.hue + (Math.random() - 0.5) * 40,\n      life: 1,\n      decay: 0.008 + Math.random() * 0.012,\n      size: 2 + Math.random() * 2\n    });\n  }\n}\n\nfunction fireworksLoop() {\n  if (!fireworksActive) return;\n  fireworksRAF = requestAnimationFrame(fireworksLoop);\n\n  ctx.globalCompositeOperation = 'destination-out';\n  ctx.fillStyle = 'rgba(0,0,0,0.15)';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.globalCompositeOperation = 'lighter';\n\n  const now = performance.now();\n  if (now - lastLaunch > 300 + Math.random() * 400) {\n    launchRocket();\n    lastLaunch = now;\n  }\n\n  for (let i = rockets.length - 1; i >= 0; i--) {\n    const r = rockets[i];\n    r.trail.push({ x: r.x, y: r.y });\n    if (r.trail.length > 8) r.trail.shift();\n\n    r.y -= r.speed;\n    r.x += (Math.random() - 0.5) * 0.5;\n\n    ctx.beginPath();\n    ctx.arc(r.x, r.y, 3, 0, Math.PI * 2);\n    ctx.fillStyle = `hsl(${r.hue}, 100%, 70%)`;\n    ctx.fill();\n\n    for (let j = 0; j < r.trail.length; j++) {\n      const t = r.trail[j];\n      const alpha = (j + 1) / r.trail.length * 0.5;\n      ctx.beginPath();\n      ctx.arc(t.x, t.y, 1.5, 0, Math.PI * 2);\n      ctx.fillStyle = `hsla(${r.hue}, 100%, 60%, ${alpha})`;\n      ctx.fill();\n    }\n\n    if (r.y <= r.targetY) {\n      explodeRocket(r);\n      rockets.splice(i, 1);\n    }\n  }\n\n  for (let i = particles.length - 1; i >= 0; i--) {\n    const p = particles[i];\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vy += 0.04;\n    p.vx *= 0.99;\n    p.life -= p.decay;\n\n    if (p.life <= 0) {\n      particles.splice(i, 1);\n      continue;\n    }\n\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\n    ctx.fillStyle = `hsla(${p.hue}, 100%, ${50 + p.life * 30}%, ${p.life})`;\n    ctx.fill();\n  }\n}\n\nresetBtn.addEventListener('click', init);\ndocument.querySelectorAll('.controls button').forEach(btn => {\n  btn.addEventListener('click', () => {\n    document.querySelectorAll('.controls button').forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    level = btn.dataset.level;\n    init();\n  });\n});\n\ninit();\n</script>\n</body>\n</html>\n"
