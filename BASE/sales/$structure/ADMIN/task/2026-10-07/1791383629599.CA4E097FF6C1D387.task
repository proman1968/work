n;\n  122\t  flagged[r][c] = !flagged[r][c];\n  123\t  const flagCount = flagged.flat().filter(Boolean).length;\n  124\t  mineCounterEl.textContent = totalMines - flagCount;\n  125\t  render();\n  126\t}\n  127\t\n  128\tfunction startTimer() {\n  129\t  timerInterval = setInterval(() => {\n  130\t    seconds++;\n  131\t    timerEl.textContent = seconds;\n  132\t  }, 1000);\n  133\t}\n  134\t\n  135\tfunction lose(hitR, hitC) {\n  136\t  gameOver = true;\n  137\t  clearInterval(timerInterval);\n  138\t  resetBtn.textContent = '😵';\n  139\t  messageEl.textContent = '💥 Бум! Попробуй ещё раз.';\n  140\t  messageEl.className = 'lose';\n  141\t  for (const [mr, mc] of mines) {\n  142\t    revealed[mr][mc] = true;\n  143\t    if (mr === hitR && mc === hitC) board[mr][mc] = -2;\n  144\t  }\n  145\t  render();\n  146\t}\n  147\t\n  148\tfunction checkWin() {\n  149\t  if (revealedCount === rows * cols - totalMines) {\n  150\t    gameOver = true;\n  151\t    clearInterval(timerInterval);\n  152\t    resetBtn.textContent = '😎';\n  153\t    messageEl.textContent = '🎉 Победа! Время: ' + seconds + 'с';\n  154\t    messageEl.className = 'win';\n  155\t  }\n  156\t}\n  157\t\n  158\tfunction render() {\n  159\t  boardEl.style.gridTemplateColumns = `repeat(${cols}, 32px)`;\n  160\t  boardEl.innerHTML = '';\n  161\t  for (let r = 0; r < rows; r++) {\n  162\t    for (let c = 0; c < cols; c++) {\n  163\t      const cell = document.createElement('div');\n  164\t      cell.className = 'cell';\n  165\t      if (revealed[r][c]) {\n  166\t        cell.classList.add('revealed');\n  167\t        if (board[r][c] === -1 || board[r][c] === -2) {\n  168\t          cell.classList.add('mine');\n  169\t          cell.textContent = '💣';\n  170\t        } else if (board[r][c] > 0) {\n  171\t          cell.classList.add('n' + board[r][c]);\n  172\t          cell.textContent = board[r][c];\n  173\t        }\n  174\t      } else if (flagged[r][c]) {\n  175\t        cell.classList.add('flagged');\n  176\