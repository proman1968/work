            "text": "@@ -317 +317 @@\n   return moving;\n }\n \n+/* ===================== ПРАВИЛА ===================== */\n+function myColor(p){ return colors[p]; }\n+function isOwnBall(b, p){\n+  const c = myColor(p);\n+  if(!c) return b.group!=='cue'; // до выбора цвета — любой цветной\n+  return b.group===c || b.group==='free';\n+}\n+function checkWin(p){\n+  const c = myColor(p);\n+  if(!c) return false;\n+  const own = balls.filter(b=>!b.potted && b.group===c);\n+  const free = balls.filter(b=>!b.potted && b.group==='free');\n+  return own.length===0 && free.length===0;\n+}\n+function endTurn(){\n+  // определить фол\n+  let foul = false;\n+  let reason = '';\n+  if(cuePotted){ foul=true; reason='Сбит белый шар'; }\n+  else if(firstHit===null){ foul=true; reason='Не задет ни один шар'; }\n+  else {\n+    const c = myColor(current);\n+    if(c){\n+      if(firstHit.group!=='free' && firstHit.group!==c){ foul=true; reason='Первым задет чужой шар'; }\n+    }\n+  }\n+  // выбор цвета после первого легального сбитого\n+  if(!colors[current] && !foul && pottedThisTurn.length>0 && !breakShot){\n+    const g = pottedThisTurn[0].group;\n+    if(g==='red'||g==='black'){\n+      colors[current] = g;\n+      colors[1-current] = (g==='red')?'black':'red';\n+      reason = 'Цвет выбран: ' + (g==='red'?'красный':'чёрный');\n+    }\n+  }\n+  // победа\n+  if(checkWin(current)){\n+    winner = current; state='over';\n+    showOverlay('Победа!', 'Игрок '+(current+1)+' сбил все шары своего цвета и свободный шар.', 'Новая игра');\n+    snd.win(); updateUI(); return;\n+  }\n+  // смена хода\n+  if(foul){\n+    state = 'place';\n+    // вернуть белый шар\n+    cue.potted = false; cue.vx=0; cue.vy=0;\n+    cue.x = HEAD_X - 40; cue.y = PLAY.y + PLAY.h/2;\n+    msg('Фол: '+reason+'. Соперник ставит белый шар за линией.');\n+  } else {\n+    if(pottedThisTurn.length>0 && !breakShot){\n+      // остался бить (сбил свой)\n+      msg('Хорошо! Игрок '+(current+1)+' бьёт снова.');\n+    } else {\n+      current = 1-current;\n+      msg('Ход переходит к Игроку '+(current+1)+'.');\n+    }\n+  }\n+  breakShot = false;\n+  pottedThisTurn = []; firstHit = null; cuePotted = false;\n+  power = 0; updateUI();\n+}\n+\n+/* ===================== УДАР ===================== */\n+function shoot(){\n+  if(state!=='charging') return;\n+  const dx = aim.x - cue.x, dy = aim.y - cue.y;\n+  const d = Math.hypot(dx,dy) || 1;\n+  const sp = power * MAX_POWER / 100;\n+  cue.vx = dx/d * sp; cue.vy = dy/d * sp;\n+  state = 'rolling';\n+  pottedThisTurn = []; firstHit = null; cuePotted = false;\n+  snd.shoot();\n+  updateUI();\n+}\n+\n+/* ===================== ВВОД ===================== */\n+function canvasPos(e){\n+  const r = cv.getBoundingClientRect();\n+  const cx = (e.touches? e.touches[0].clientX : e.clientX);\n+  const cy = (e.touches? e.touches[0].clientY : e.clientY);\n+  return { x:(cx-r.left)*(W/r.width), y:(cy-r.top)*(H/r.height) };\n+}\n+cv.addEventListener('mousemove', e=>{\n+  const p = canvasPos(e); aim.x=p.x; aim.y=p.y;\n+  if(state==='place'){ cue.x=p.x; cue.y=p.y; }\n+});\n+cv.addEventListener('mousedown', e=>{\n+  ac();\n+  const p = canvasPos(e); aim.x=p.x; aim.y=p.y;\n+  if(state==='aim'){ charging=true; state='charging'; power=0; }\n+  else if(state==='place'){\n+    // поставить белый шар (только за линией)\n+    if(p.x < HEAD_X){ cue.x=p.x; cue.y=p.y; state='aim'; msg('Белый шар поставлен. Бей!'); updateUI(); }\n+    else msg('Ставьте белый шар ЗА линией (левая часть).');\n+  }\n+});\n+window.addEventListener('mouseup', e=>{\n+  if(state==='charging'){ shoot(); }\n+});\n+// touch\n+cv.addEventListener('touchstart', e=>{ e.preventDefault(); ac();\n+  const p = canvasPos(e); aim.x=p.x; aim.y=p.y;\n+  if(state==='aim'){ charging=true; state='charging'; power=0; }\n+  else if(state==='place'){ if(p.x<HEAD_X){ cue.x=p.x; cue.y=p.y; state='aim'; updateUI(); } }\n+}, {passive:false});\n+cv.addEventListener('touchmove', e=>{ e.preventDefault();\n+  const p = canvasPos(e); aim.x=p.x; aim.y=p.y;\n+  if(state==='place'){ cue.x=p.x; cue.y=p.y; }\n+}, {passive:false});\n+cv.addEventListener('touchend', e=>{ e.preventDefault(); if(state==='charging') shoot(); }, {passive:false});\n+\n+/* ===================== ОТРИСОВКА ===================== */\n+function drawTable(){\n+  // дерево\n+  ctx.fillStyle = '#3a2412'; ctx.fillRect(0,0,W,H);\n+  // борта\n+  ctx.fillStyle = '#5a3418';\n+  roundRect(PLAY.x-18, PLAY.y-18, PLAY.w+36, PLAY.h+36, 20); ctx.fill();\n+  ctx.fillStyle = '#6b4020';\n+  roundRect(PLAY.x-10, PLAY.y-10, PLAY.w+20, PLAY.h+20, 14); ctx.fill();\n+  // сукно\n+  const g = ctx.createRadialGradient(W/2,H/2,50, W/2,H/2, W/2);\n+  g.addColorStop(0,'#0e7a44'); g.addColorStop(1,'#0a5c33');\n+  ctx.fillStyle = g;\n+  ctx.fillRect(PLAY.x, PLAY.y, PLAY.w, PLAY.h);\n+  // линия (head string)\n+  ctx.strokeStyle = 'rgba(255,255,255,.18)'; ctx.lineWidth=2;\n+  ctx.beginPath(); ctx.moveTo(HEAD_X, PLAY.y); ctx.lineTo(HEAD_X, PLAY.y+PLAY.h); ctx.stroke();\n+  // лузы\n+  for(const p of POCKETS){\n+    ctx.fillStyle = '#0a0a0a';\n+    ctx.beginPath(); ctx.arc(p.x,p.y,POCKET_R,0,Math.PI*2); ctx.fill();\n+    ctx.strokeStyle = '#2a1a0c'; ctx.lineWidth=3; ctx.stroke();\n+  }\n+}\n+function roundRect(x,y,w,h,r){\n+  ctx.beginPath();\n+  ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);\n+  ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();\n+}\n+function drawBall(b){\n+  if(b.potted) return;\n+  // тень\n+  ctx.fillStyle='rgba(0,0,0,.3)';\n+  ctx.beginPath(); ctx.ellipse(b.x+2,b.y+3,b.r,b.r*0.9,0,0,Math.PI*2); ctx.fill();\n+  // тело\n+  const g = ctx.createRadialGradient(b.x-b.r*0.35,b.y-b.r*0.4,b.r*0.2, b.x,b.y,b.r);\n+  g.addColorStop(0, lighten(b.color,0.5));\n+  g.addColorStop(0.5, b.color);\n+  g.addColorStop(1, darken(b.color,0.4));\n+  ctx.fillStyle=g;\n+  ctx.beginPath(); ctx.arc(b.x,b.y,b.r,0,Math.PI*2); ctx.fill();\n+  // блик\n+  ctx.fillStyle='rgba(255,255,255,.55)';\n+  ctx.beginPath(); ctx.arc(b.x-b.r*0.3,b.y-b.r*0.35,b.r*0.28,0,Math.PI*2); ctx.fill();\n+  // номер\n+  if(b.n>0){\n+    ctx.fillStyle='#fff';\n+    ctx.beginPath(); ctx.arc(b.x,b.y,b.r*0.5,0,Math.PI*2); ctx.fill();\n+    ctx.fillStyle='#111'; ctx.font='bold '+(b.r*0.7)+'px Arial';\n+    ctx.textAlign='center'; ctx.textBaseline='middle';\n+    ctx.fillText(b.n, b.x, b.y+0.5);\n+  }\n+}\n+function lighten(hex,amt){ return shade(hex,amt); }\n+function darken(hex,amt){ return shade(hex,-amt); }\n+function shade(hex,amt){\n+  const c = hex.replace('#','');\n+  let r=parseInt(c.substr(0,2),16), g=parseInt(c.substr(2,2),16), b=parseInt(c.substr(4,2),16);\n+  r=Math.max(0,Math.min(255, Math.round(r + (amt>0?(255-r)*amt:r*(1+amt)))));\n+  g=Math.max(0,Math.min(255, Math.round(g + (amt>0?(255-g)*amt:g*(1+amt)))));\n+  b=Math.max(0,Math.min(255, Math.round(b + (amt>0?(255-b)*amt:b*(1+amt)))));\n+  return 'rgb('+r+','+g+','+b+')';\n+}\n+function drawAim(){\n+  if(state!=='aim' && state!=='charging') return;\n+  const dx = aim.x-cue.x, dy=aim.y-cue.y;\n+  const d = Math.hypot(dx,dy)||1;\n+  const nx=dx/d, ny=dy/d;\n+  // линия прицела\n+  ctx.strokeStyle = 'rgba(255,255,255,.5)'; ctx.lineWidth=2; ctx.setLineDash([6,6]);\n+  ctx.beginPath(); ctx.moveTo(cue.x,cue.y);\n+  ctx.lineTo(cue.x+nx*200, cue.y+ny*200); ctx.stroke();\n+  ctx.setLineDash([]);\n+  // стрелка силы\n+  if(state==='charging'){\n+    const len = 30 + power*1.2;\n+    ctx.strokeStyle = power>70?'#e0563a':(power>40?'#e8c14a':'#3fae6a');\n+    ctx.lineWidth=4;\n+    ctx.beginPath(); ctx.moveTo(cue.x,cue.y); ctx.lineTo(cue.x-nx*len, cue.y-ny*len); ctx.stroke();\n+  }\n+}\n+function render(){\n+  drawTable();\n+  for(const b of balls) if(b.n!==0) drawBall(b);\n+  if(cue) drawBall(cue);\n+  drawAim();\n+}\n+\n+/* ===================== UI ===================== */\n+function msg(t){ document.getElementById('msg').textContent = t; }\n+function updateUI(){\n+  document.getElementById('turn').textContent = 'Игрок '+(current+1);\n+  document.getElementById('pc0').classList.toggle('active', current===0 && state!=='over');\n+  document.getElementById('pc1').classList.toggle('active', current===1 && state!=='over');\n+  const colName = c => c==='red'?'красный':(c==='black'?'чёрный':'цвет не выбран');\n+  document.getElementById('col0').textContent = colName(colors[0]);\n+  document.getElementById('col1').textContent = colName(colors[1]);\n+  document.getElementById('dot0').style.background = colors[0]==='red'?'var(--red)':(colors[0]==='black'?'var(--black)':'#555');\n+  document.getElementById('dot1').style.background = colors[1]==='red'?'var(--red)':(colors[1]==='black'?'var(--black)':'#555');\n+  // сбитые\n+  const p0 = balls.filter(b=>b.potted && b.n!==0 && (colors[0]?(b.group===colors[0]||b.group==='free'):false)).length;\n+  const p1 = balls.filter(b=>b.potted && b.n!==0 && (colors[1]?(b.group===colors[1]||b.group==='free'):false)).length;\n+  document.getElementById('pots0').textContent = colors[0]? p0 : '—';\n+  document.getElementById('pots1').textContent = colors[1]? p1 : '—';\n+  document.getElementById('pct').textContent = Math.round(power)+'%';\n+  document.getElementById('bar').style.width = power+'%';\n+}\n+function showOverlay(title, text, btn){\n+  document.getElementById('ovTitle').textContent = title;\n+  document.getElementById('ovText').textContent = text;\n+  document.getElementById('ovRules').style.display='none';\n+  document.getElementById('ovBtn').textContent = btn;\n+  document.getElementById('overlay').classList.add('show');\n+}\n+function hideOverlay(){ document.getElementById('overlay').classList.remove('show'); }\n+\n+/* ===================== КНОПКИ ===================== */\n+document.getElementById('btnNew').onclick = ()=>{ newGame(); };\n+document.getElementById('btnSound').onclick = function(){ soundOn=!soundOn; this.textContent = soundOn?'🔊 Звук':'🔇 Звук'; };\n+document.getElementById('btnRules').onclick = ()=>{\n+  document.getElementById('ovTitle').textContent='Правила';\n+  document.getElementById('ovText').textContent='Русский бильярд — «русская пирамида».';\n+  document.getElementById('ovRules').style.display='block';\n+  document.getElementById('ovBtn').textContent='Понятно';\n+  document.getElementById('overlay').classList.add('show');\n+};\n+document.getElementById('ovBtn').onclick = ()=>{\n+  hideOverlay();\n+  if(state==='over') newGame();\n+};\n+\n+/* ===================== ЦИКЛ ===================== */\n+function newGame(){\n+  rackBalls();\n+  current = 0; colors=[null,null]; winner=-1;\n+  state='aim'; breakShot=true; power=0;\n+  pottedThisTurn=[]; firstHit=null; cuePotted=false;\n+  msg('Игрок 1 бьёт из-под бита.');\n+  updateUI();\n+}\n+function loop(){\n+  if(state==='charging'){\n+    power = Math.min(100, power + 2.2);\n+    updateUI();\n+  }\n+  if(state==='rolling'){\n+    // несколько подшагов для стабильности\n+    let moving = false;\n+    for(let s=0;s<3;s++){ moving = stepPhysics() || moving; }\n+    if(!moving){ state='aim'; endTurn(); }\n+  }\n+  render();\n+  requestAnimationFrame(loop);\n+}\n+\n+/* ===================== СТАРТ ===================== */\n+newGame();\n+showOverlay('Русский бильярд','Классическая «русская пирамида» на 15 шаров. Сбей все шары своего цвета и свободный №8.','Начать игру');\n+loop();\n+</script>\n+</body>\n+</html>\n+"
