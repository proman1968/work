,\n  {name:\"Амортизация\", sum:34378.05, pct:0.10, unit:0.02}\n];\nconst susloData = [\n  {name:\"Солод\", sum:19912923.08, pct:76.46, unit:39.51},\n  {name:\"Хмель\", sum:2362753.87, pct:9.07, unit:4.69},\n  {name:\"Стабилизаторы, ферменты\", sum:2085405.91, pct:8.01, unit:4.14},\n  {name:\"Ячмень\", sum:479397.05, pct:1.84, unit:1.06},\n  {name:\"Молочная кислота\", sum:466753.62, pct:1.79, unit:0.97},\n  {name:\"Пищевые добавки\", sum:266540.73, pct:1.02, unit:0.87},\n  {name:\"Углекислота\", sum:262918.12, pct:1.01, unit:0.52},\n  {name:\"Вода\", sum:207792.06, pct:0.80, unit:0.41}\n];\n\nconst colors = [\"#2563eb\",\"#059669\",\"#d97706\",\"#dc2626\",\"#7c3aed\",\"#0891b2\",\"#be185d\",\"#4b5563\",\"#65a30d\",\"#0d9488\",\"#ca8a04\",\"#9333ea\",\"#e11d48\",\"#1d4ed8\",\"#059669\",\"#d97706\",\"#6b7280\",\"#4f46e5\",\"#0891b2\",\"#be185d\",\"#7c3aed\",\"#2563eb\",\"#059669\"];\n\nfunction fmt(n) { return n.toLocaleString('ru-RU',{maximumFractionDigits:0}); }\nfunction fmt2(n) { return n.toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2}); }\n\n// Donut chart\nfunction drawDonut(data) {\n  const svg = document.getElementById('donut');\n  const total = data.reduce((s,d)=>s+d.pct,0);\n  const cx=110,cy=110,r=85,sw=32;\n  let angle=-90;\n  let paths='';\n  data.forEach((d,i)=>{\n    const sweep = d.pct/total*360;\n    const large = sweep>180?1:0;\n    const x1=cx+r*Math.cos(angle*Math.PI/180), y1=cy+r*Math.sin(angle*Math.PI/180);\n    angle+=sweep;\n    const x2=cx+r*Math.cos(angle*Math.PI/180), y2=cy+r*Math.sin(angle*Math.PI/180);\n    if(sweep>=359.9){\n      paths+=`<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"${colors[i%colors.length]}\" stroke-width=\"${sw}\"/>`;\n    } else {\n      paths+=`<path d=\"M${x1},${y1} A${r},${r} 0 ${large} 1 ${x2},${y2}\" fill=\"none\" stroke=\"${colors[i%colors.length]}\" stroke-width=\"${sw}\" stroke-linecap=\"butt\" data-idx=\"${i}\"/>`;\n    }\n  });\n  svg.innerHTML=paths;\n  // Legend\n  const legend=document.getElementById('legend');\n  legend.innerHTML=data.slice(0,10).map((d,i)=>`<div class=\"legend-item\" data-idx=\"${i}\"><div class=\"legend-dot\" style=\"background:${colors[i%colors.length]}\"></div><span>${d.name}</span><span class=\"legend-pct\">${d.pct}%</span></div>`).join('')+`<div class=\"legend-item\" style=\"color:var(--muted);font-style:italic\"><span>…и ещё ${Math.max(0,data.length-10)} статей</span></div>`;\n}\n\n// Bars\nfunction drawBars(containerId, data, unitLabel) {\n  const el=document.getElementById(containerId);\n  const maxSum=data[0].sum;\n  el.innerHTML=data.map((d,i)=>{\n    const w=Math.max(2,(d.sum/maxSum)*100);\n    return `<div class=\"bar-row\" data-idx=\"${i}\">\n      <div class=\"bar-label\" title=\"${d.name}\">${d.name}</div>\n      <div class=\"bar-track\"><div class=\"bar-fill\" style=\"width:${w}%;background:${colors[i%colors.length]}\">${d.pct>=5?d.pct+'%':''}</div></div>\n      <div class=\"bar-val\">${fmt(d.sum)}</div>\n      <div class=\"bar-pct\">${d.pct}%</div>\n    </div>`;\n  }).join('');\n}\n\n// Tables\nfunction drawTable(tableId, data, unitLabel) {\n  const tbody=document.querySelector(`#${tableId} tbody`);\n  tbody.innerHTML=data.map(d=>`<tr><td>${d.name}</td><td class=\"num\">${fmt(d.sum)}</td><td class=\"pct\">${d.pct}%</td><td class=\"num\">${fmt2(d.unit)}</td></tr>`).join('');\n  // Sort\n  document.querySelectorAll(`#${tableId} th`).forEach(th=>{\n    th.addEventListener('click',()=>{\n      const col=th.dataset.col;\n      const asc=th.dataset.asc!=='1';\n      document.querySelectorAll(`#${tableId} th`).forEach(t=>{delete t.dataset.asc; t.querySelector('.arrow')?.remove();});\n      th.dataset.asc=asc?'1':'0';\n      th.insertAdjacentHTML('beforeend',`<span class=\"arrow\">${asc?'▲':'▼'}</span>`);\n      const sorted=[...data].sort((a,b)=>asc?a[col]-b[col]:b[col]-a[col]);\n      tbody.innerHTML=sorted.map(d=>`<tr><td>${d.name}</td><td class=\"num\">${fmt(d.sum)}</td><td class=\"pct\">${d.pct}%</td><td class=\"num\">${fmt2(d.unit)}</td></tr>`).join('');\n    });\n  });\n}\n\n// Tooltip\nconst tooltip=document.getElementById('tooltip');\ndocument.addEventListener('mousemove',e=>{\n  const t=e.target.closest('[data-idx]');\n  if(t && (t.classList.contains('bar-row')||t.classList.contains('legend-item')||t.tagName==='path')){\n    const idx=+t.dataset.idx;\n    const d=mainData[idx];\n    if(d){\n      tooltip.innerHTML=`<strong>${d.name}</strong><br>${fmt(d.sum)} ₽ · ${d.pct}% · ${fmt2(d.unit)} ₽/л`;\n      tooltip.classList.add('show');\n      tooltip.style.left=(e.clientX+12)+'px';\n      tooltip.style.top=(e.clientY-10)+'px';\n    }\n  } else { tooltip.classList.remove('show'); }\n});\n\n// Tabs\ndocument.querySelectorAll('.tab').forEach(tab=>{\n  tab.addEventListener('click',()=>{\n    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));\n    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));\n    tab.classList.add('active');\n    document.getElementById('panel-'+tab.dataset.tab).classList.add('active');\n  });\n});\n\n// Init\ndrawDonut(mainData);\ndrawBars('main-bars', mainData);\ndrawBars('solog-bars', sologData);\ndrawBars('suslo-bars', susloData);\ndrawTable('main-table', mainData);\ndrawTable('solog-table', sologData);\ndrawTable('suslo-table', susloData);\n</script>\n"
