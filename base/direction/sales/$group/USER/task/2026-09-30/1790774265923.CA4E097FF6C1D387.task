.from([1, 1, 0, 0, 0, 0, 0, 1, 4]), ...attributes.map(([key, value]) => {\n   33\t        const n = Buffer.from(key), v = Buffer.from(value), head = Buffer.alloc(3), len = Buffer.alloc(2);\n   34\t        head[0] = 0x44; head.writeUInt16BE(n.length, 1); len.writeUInt16BE(v.length);\n   35\t        return Buffer.concat([head, n, len, v]);\n   36\t    }), Buffer.from([3])]);\n   37\t}\n   38\tbefore(async () => {\n   39\t    prev = process.cwd();\n   40\t    const tempRoot = path.join(process.env.TEMP || os.tmpdir(), 'opencode');\n   41\t    await fsp.mkdir(tempRoot, { recursive: true });\n   42\t    tmp = await fsp.mkdtemp(path.join(tempRoot, 'lan-test-'));\n   43\t    write('#system/os.json', JSON.stringify(cfg));\n   44\t    write('$server/class.js', `export default { '#security': { ADMINS: ['admin'] } }`);\n   45\t    write('$server/$folder/class.js', 'export default {}');\n   46\t    write('$server/$folder/$class/class.js', 'export default {}');\n   47\t    write('$server/$folder/$class/$service/class.js', 'export default {}');\n   48\t    write('$server/$folder/$file/class.js', 'export default {}');\n   49\t    write('SERVICES/$service/class.js', 'export default {}');\n   50\t    write('TARGET/$class/class.js', `export default { '#security': { USERS: ['worker'] } }`);\n   51\t    process.chdir(tmp); globalThis.WORK = new $server();\n   52\t    server = http.createServer(async (req, res) => {\n   53\t        const chunks = []; for await (const c of req) chunks.push(c);\n   54\t        const body = Buffer.concat(chunks), url = new URL(req.url, 'http://test');\n   55\t        if (url.pathname === '/large') { res.end('x'.repeat(20000)); return; }\n   56\t        if (url.pathname === '/redirect') { res.writeHead(302, { location: 'http://10.0.0.1/' }); res.end(); return; }\n   57\t        if (url.pathname === '/slow') { setTimeout(() => res.end('late'), 100); return; }\n   58\t        if (url.pathname === '/ipp/print') {\n   59\t            if (body.readUInt16BE(2) === 2) { printCount++; assert.ok(body.includes(Buffer.from('%PDF'))); }\n   60\t            res.setHeader('content-type', 'application/ipp'); res.end(ippReply()); return;\n   61\t        }\n   62\t        if (url.pathname === '/eSCL/ScannerCapabilities') {\n   63\t            res.end('<scan:ScannerCapabilities>application/pdf</scan:ScannerCapabilities>'); return;\n   64\t        }\n   65\t        if (url.pathname === '/eSCL/ScannerStatus') { res.end('<ScannerStatus>Idle</ScannerStatus>'); return; }\n   66\t        if (url.pathname === '/eSCL/ScanJobs') {\n   67\t            assert.match(body.toString(), /ScanSettings/);\n   68\t            res.writeHead(201, { location: '/eSCL/ScanJobs/1' }); res.end(); return;\n   69\t        }\n   70\t        if (url.pathname === '/eSCL/ScanJobs/1/NextDocument') {\n   71\t            if (!pageAttempts++) { res.writeHead(503, { 'retry-after': '0' }); res.end(); return; }\n   72\t            res.setHeader('content-type', 'application/pdf'); res.end('%PDF-scan'); return;\n   73\t        }\n   74\t        if (url.pathname === '/eSCL/ScanJobs/1' && req.method === 'DELETE') { deleteCount++; res.end(); return; }\n   75\t        if (url.pathname.startsWith('/base/odata/standard.odata/')) {\n   76\t            lastOdata = url;\n   77\t            res.setHeader('content-type', 'application/json');\n   78\t            if (url.pathname.endsWith('$metadata')) res.end('<EntitySet Name=\"Catalog_Товары\"/>');\n   79\t            else res.end(JSON.stringify({ value: [{ Description: 'Товар' }] }));\n   80\t            return;\n   81\t        }\n   82\t        res.end('<title>Test device</title>');\n   83\t    });\n   84\t    await new Promise(r => server.listen(0, '127.0.0.1', r));\n   85\t    base = 'http://127.0.0.1:' + server.address().port;\n   86\t});\n   87\tafter(async () => {\n   88\t    await new Promise(r => server.close(r));\n   89\t    await new Promise(r => setTimeout(r, 300));\n   90\t    closeIndexDb(); process.chdir(prev); await fsp.rm(tmp, { recursive: true, force: true });\n   91\t});\n   92\t\n   93\tit('CIDR валидируется строго, лимит хостов и границы подсети соблюдаются', async () => {\n   94\t    assert.equal(parseCidr('192.168.4.7/24').count, 254);\n   95\t    assert.equal(parseCidr('127.0.0.1/32').count, 1);\n   96\t    for (const s of ['127..0.1', '127.0.0.1/24/2', '1.2.3.4/', '999.2.3.4']) assert.throws(() => parseCidr(s));\n   97\t    assert.throws(() => allowedCidr('127.0.0.0/16', cfg), /слишком большая/);\n   98\t    assert.throws(() => allowedCidr('192.168.1.1/32', cfg), /не разрешена/);\n   99\t    await assert.rejects(resolveHost('8.8.8.8', cfg), /вне разрешённых/);\n  100\t    await assert.rejects(resolvePublicUrl('http://[::ffff:127.0.0.1]/'), /внутренняя сеть/);\n  101\t});\n  102\tit('HTTP: лимит тела, полный timeout, отмена, отсутствие перехода по redirect', async () => {\n  103\t    await assert.rejects(lanRequest(base + '/large', cfg, { maxBytes: 32 }), /лимит/);\n  104\t    await assert.rejects(lanRequest(base + '/slow', cfg, { timeout: 10 }), /Таймаут/);\n  105\t    await assert.rejects(lanRequest(base, cfg, { signal: AbortSignal.abort() }));\n  106\t    assert.equal((await lanRequest(base + '/redirect', cfg)).status, 302);\n  107\t});\n  108\tit('TCP scan на loopback обнаруживает только открытый тестовый порт', async () => {\n  109\t    const res = await scan('127.0.0.1/32', cfg, { ports: [server.address().port] });\n  110\t    assert.equal(res.checked, 1); assert.equal(res.candidates.length, 1);\n  111\t    assert.equal(res.candidates[0].confidence, 'port-only');\n  112\t    assert.deepEqual((await ippRequest(base + '/ipp/print', cfg))['printer-make-and-model'], ['Test printer']);\n  113\t    assert.equal((await probe('127.0.0.1', cfg, { url: base })).confidence, 'escl');\n  114\t});\n  115\tit('discovery: повреждённый DNS отклоняется, объявления не считаются подтверждённым протоколом', () => {\n  116\t    const loop = Buffer.alloc(24); loop.writeUInt16BE(1, 6); loop[12] = 0xc0; loop[13] = 12;\n  117\t    assert.throws(() => parseDns(loop), /DNS/);\n  118\t    const rows = dnsCandidates([\n  119\t        { type: 33, name: 'Printer._ipp._tcp.local', value: { target: 'printer.local', port: 631 } },\n  120\t        { type: 1, name: 'printer.local', value: '127.0.0.1' },\n  121\t        { type: 16, name: 'Printer._ipp._tcp.local', value: { ty: 'Office', rp: 'ipp/print' } },\n  122\t    ], ip => ip === '127.0.0.1');\n  123\t    assert.equal(rows[0].kind, 'printer'); assert.equal(rows[0].url, 'http://127.0.0.1:631/ipp/print');\n  124\t    assert.equal(parseAnnouncement('HTTP/1.1 200 OK\\r\\nLocation: http://127.0.0.1/info\\r\\nST: printer', '127.0.0.1', 'ssdp')[0].confidence, 'advertised');\n  125\t    assert.throws(() => decodeIpp(Buffer.from([1, 1, 0])), /IPP/);\n  126\t});\n  127\tit('кандидат регистрируется классом сервиса, повторная регистрация не перезаписывает', async () => {\n  128\t    store.merge([{ host: '127.0.0.1', port: server.address().port, kind: 'web', url: base, label: 'Device' }]);\n  129\t    const id = Object.keys(store.load())[0];\n  130\t    const result = await register({ id, name: 'Device' }, { session });\n  131\t    assert.equal(result.path, '/SERVICES/LAN/Device');\n  132\t    const service = await WORK.get_item(result.path);\n  133\t    assert.equal(service.DATA.lanKind, 'web'); assert.equal(typeof service.status, 'function');\n  134\t    assert.equal((await service.status({ session })).status, 200);\n  135\t    assert.ok((await serviceTools(session)).some(t => t.source?.service === result.path && t.readonly));\n  136\t    assert.ok(!(await serviceTools({ uid: 'outsider' })).some(t => t.source?.service === result.path));\n  137\t    await assert.rejects(register({ id, name: 'Device' }, { session }), /уже существует/);\n  138\t    await assert.rejects(service.status({ session: { uid: 'outsider' } }), /Доступ запрещён/);\n  139\t});\n  140\tit('OData: имена сущностей, фильтры и лимит; сетевому узлу коннектор не выдаётся', async () => {\n  141\t    const service = { DATA: { lanKind: 'onec', endpoint: base + '/base/odata/standard.odata/' }, canSee: async () => true };\n  142\t    const result = await execute(service, 'query', { session, entity: 'Catalog_Товары', top: 900, filter: \"Description eq 'Товар'\" });\n  143\t    assert.equal(result.value[0].Description, 'Товар'); assert.equal(lastOdata.searchParams.get('$top'), '500');\n  144\t    assert.equal(lastOdata.searchParams.get('$filter'), \"Description eq 'Товар'\");\n  145\t    await assert.rejects(execute(service, 'query', { session, entity: '../other' }), /имя сущности/);\n  146\t    await assert.rejects(execute(service, 'query', { session: { uid: 'admin', principal: { kind: 'node' } } }), /локальный пользователь/);\n  147\t});\n  148\tit('eSCL скан сохраняется с правами получателя в WORK; задание очищается', async () => {\n  149\t    const service = { DATA: { lanKind: 'scanner', endpoint: base + '/eSCL/' }, canSee: async () => true };\n  150\t    const saved = await execute(service, 'scan', { session: { uid: 'worker' }, to: '/TARGET', role: 'USER' });\n  151\t    assert.ok(saved.path.includes('/USER/'));\n  152\t    const file = await WORK.get_item(saved.path);\n  153\t    assert.equal((await file.load({ encoding: null })).toString(), '%PDF-scan');\n  154\t    assert.equal(deleteCount, 1);\n  155\t    assert.equal(pageAttempts, 2, 'страница запрошена повторно после 503');\n  156\t    await assert.rejects(execute(service, 'scan', { session: { uid: 'outsider' }, to: '/TARGET', role: 'USER' }), /Доступ запрещён/);\n  157\t    assert.equal(deleteCount, 1, 'без прав на сохранение задание не создаётся');\n  158\t});\n  159\tit('IPP печать проверяет доступ к документу и MIME до Print-Job', async () => {\n  160\t    write('TARGET/$class/USER/doc.pdf', '%PDF-document');\n  161\t    const folder = await WORK.get_item('/TARGET/$class/USER'); folder.reset();\n  162\t    const service = { DATA: { lanKind: 'printer', endpoint: base + '/ipp/print' }, canSee: async () => true };\n  163\t    await execute(service, 'print', { session: { uid: 'worker' }, path: '/TARGET/$class/USER/doc.pdf' });\n  164\t    assert.equal(printCount, 1);\n  165\t    await assert.rejects(execute(service, 'print', { session: { uid: 'outsider' }, path: '/TARGET/$class/USER/doc.pdf' }), /Доступ запрещён/);\n  166\t    assert.equal(printCount, 1);\n  167\t});\n  168\t",
