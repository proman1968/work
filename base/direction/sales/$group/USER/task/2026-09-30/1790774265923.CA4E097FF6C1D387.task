                  "result": "    1\t/**\n    2\t * Ядро агента WORK: окружение (модель, system, инструменты, субагенты, навыки) и точки входа.\n    3\t *\n    4\t *   createEnv({ place, session, mode }) → env\n    5\t *   runOnce({ place, session, prompt, model, agent }) → { status, content, items }  — разовый запуск без ленты\n    6\t *   Сессия задачи (.task) — ./session.js\n    7\t */\n    8\timport { runLoop } from './loop.js';\n    9\timport { workTools } from './tools/work.js';\n   10\timport { webTools, serviceTools, mcpTools } from './tools/services.js';\n   11\timport { metaTools, listing, MAX_DEPTH } from './tools/meta.js';\n   12\timport { connectTools } from './tools/connect.js';\n   13\timport { osFileTools } from './tools/os-files.js';\n   14\timport { osProcTools } from './tools/os-proc.js';\n   15\timport { netTools } from './tools/net.js';\n   16\timport { scheduleTools } from './tools/schedule.js';\n   17\timport { docTools } from './tools/docs.js';\n   18\timport { memoryTools, memoryBlock } from './tools/memory.js';\n   19\timport { guarded, systemAllowed } from './system.js';\n   20\t\n   21\t/** ОС сервера и локальная сеть — инструменты только для администраторов WORK. */\n   22\tconst SYSTEM_TOOLS = guarded([...osFileTools, ...osProcTools, ...netTools]);\n   23\timport { loadDocs, loadSystem, loadConfig } from './resources.js';\n   24\timport { clip } from './util.js';\n   25\t\n   26\texport { runLoop } from './loop.js';\n   27\texport { resetServiceRegistry } from './tools/services.js';\n   28\t\n   29\texport const DEFAULT_MODEL = '/MODELS/odant/Qwen3.8 27b';\n   30\t\n   31\t/** Модель WORK → адаптер llm для цикла. */\n   32\texport async function llmFor(modelPath) {\n   33\t    const path = String(modelPath || '').trim();\n   34\t    if (!path)\n   35\t        throw new Error('модель не задана (ai/config.js model или выбор в задаче)');\n   36\t    const item = await WORK.get_item(path);\n   37\t    if (!item || typeof item.streamChat !== 'function') {\n   38\t        await item?.init;\n   39\t        if (!item || typeof item.streamChat !== 'function')\n   40\t            throw new Error('модель не найдена или не умеет streamChat: ' + path);\n   41\t    }\n   42\t    await item.init;\n   43\t    const caps = Array.isArray(item.capabilities) ? item.capabilities : String(item.capabilities || '').split(/[\\s,]+/);\n   44\t    const maxOutput = Number(item.maxOutput) || undefined;\n   45\t    return {\n   46\t        name: path,\n   47\t        item,\n   48\t        contextTokens: Number(item.maxTokens) || 32000,\n   49\t        vision: caps.includes('vision'),\n   50\t        stream({ messages, tools, signal, effort }) {\n   51\t            const req = { messages, temperature: 0.3, signal };\n   52\t            if (tools?.length)\n   53\t                req.tools = tools;\n   54\t            if (maxOutput)\n   55\t                req.maxOutput = maxOutput;\n   56\t            if (effort && caps.includes('effort'))\n   57\t                req.effort = effort;\n   58\t            return item.streamChat(req);\n   59\t        },\n   60\t    };\n   61\t}\n   62\t\n   63\t/** Первая модель с capability image (или ai/config.js imageModel). */\n   64\tasync function findImageModel(config) {\n   65\t    if (config.imageModel) {\n   66\t        const m = await WORK.get_item(config.imageModel).catch(() => null);\n   67\t        if (m)\n   68\t            return m;\n   69\t    }\n   70\t    const root = await WORK.get_item('/MODELS').catch(() => null);\n   71\t    for (const provider of (await root?.items) || []) {\n   72\t        for (const m of (await provider.items) || []) {\n   73\t            await m.init;\n   74\t            const caps = Array.isArray(m.capabilities) ? m.capabilities : String(m.capabilities || '').split(/[\\s,]+/);\n   75\t            if (caps.includes('image') && typeof m.generateImage === 'function')\n   76\t                return m;\n   77\t        }\n   78\t    }\n   79\t    return null;\n   80\t}\n   81\t\n   82\tconst ENV_GUIDE = `# Среда WORK\n   83\tWORK — система управления деятельностью, где всё — файлы и классы в одном дереве.\n   84\t- Путь: /КЛАСС/ПОДКЛАСС/файл. Класс — узел структуры (организация, отдел, справочник, модель ИИ…), у него метапапка $тип с class.js (данные/методы) и readme.md (контракт: что здесь хранится и как с этим работать).\n   85\t- Наследование «~»: класс получает слои своих типизаторов; /X/~/readme.md — собранный контракт, /X/~/class.js — собранный код.\n   86\t- Файлы данных пишутся в рабочую зону роли класса; каждая запись оставляет снимок в истории и строку в журнале (logs) — всё обратимо (history/restore).\n   87\t- Контракт места (readme) — закон: прежде чем создавать/менять, прочитай его (read класса) и следуй ему.\n   88\t# Как работать\n   89\t- Сначала разберись (ls/read/find/schema), потом действуй; не выдумывай пути — проверяй.\n   90\t- Независимые чтения вызывай параллельно в одном ходе.\n   91\t- Задачи из 3+ шагов — веди план todo_write; широкое исследование — поручай субагенту (task).\n   92\t- Правка существующего файла — edit (точечно), новый файл — write, новый класс — create_class, прочие операции — schema → call.\n   93\t- Большой текст/HTML не отправляй целиком в один write: создай файл коротким write, затем добавляй части через append (несколько тысяч символов за вызов). Путь бери из результата write; после каждой части проверь итоговый файл.\n   94\t- Меняя код/конфигурацию системы ($server, sources, oda, MODELS, SERVICES, *.js), объясни зачем — человек подтвердит.\n   95\t- Спрашивай человека (ask_user) только о том, что нельзя выяснить самому.\n   96\t- «Доступ запрещён» — не обходи (другими путями, ролями, копиями): объясни пользователю и предложи escalate — запрос ответственному.\n   97\t- Устойчивые факты, решения и предпочтения, которые пригодятся в следующих задачах, сохраняй memory (remember); устаревшее — forget.\n   98\t- Отвечай по-русски, по делу, markdown; ссылки на элементы — WORK-путями. В конце работы — краткий итог: что сделано, где результат.\n   99\t- Удачную повторяемую работу предложи сохранить навыком (save_skill).\n  100\t# Внешние сервисы (аккаунты пользователя)\n  101\t- Ты можешь действовать в интернет-сервисах через их API: календари, почта, диски, задачи, CRM, GitHub и любой API по токену (http_request).\n  102\t- Доступ к аккаунту даёт только сам пользователь: проверь connections; нет нужного — connect_service (он войдёт на сайте провайдера или вставит токен в карточке). Никогда не проси пароли, коды и токены в чате и не регистрируй аккаунты сам.\n  103\t- Чтение (GET) — сразу; любое изменение (создать событие, отправить письмо, удалить…) пользователь подтверждает явно — в reason опиши по-человечески, что именно сделаешь (что, когда, кому).\n  104\t- Сайты без API (формы, клики) — не автоматизируешь: предложи пользователю ссылку и шаги.`;\n  105\t\n  106\tconst MODE_NOTE = {\n  107\t    auto: 'Режим «Авто»: чтение и запись рабочих данных — без вопросов; изменения системы и опасные действия — с подтверждением.',\n  108\t    ask: 'Режим «Спрашивать»: каждое действие с побочным эффектом подтверждает человек.',\n  109\t    plan: 'Режим «План»: только исследование и план, изменения запрещены. В конце — предложи план и попроси переключить режим.',\n  110\t};\n  111\t\n  112\t/**\n  113\t * Окружение агента для места (класса) и пользователя.\n  114\t * @param {object} p\n  115\t * @param {object} p.place  класс исполнения ($context)\n  116\t * @param {object} [p.session]\n  117\t * @param {object} [p.host]  для mode\n  118\t */\n  119\texport async function createEnv({ place, session, host, tz, location, role } = {}) {\n  120\t    // ОС и сеть — администратору, работающему в роли ADMIN (или без выбранной роли: REST, расписание)\n  121\t    const system = async () => (!role || role === 'ADMIN') && await systemAllowed(session);\n  122\t    const [config, agents, skills, baseSystem] = await Promise.all([\n  123\t        loadConfig(place),\n  124\t        loadDocs(place, 'agents'),\n  125\t        loadDocs(place, 'skills'),\n  126\t        loadSystem(place),\n  127\t    ]);\n  128\t    let extTools = null;\n  129\t    let memo = null;\n  130\t    const mcpErrors = [];\n  131\t    const env = {\n  132\t        place, session, config, agents, skills, role,\n  133\t        /** Байты вложения (картинки для vision) с правами пользователя. */\n  134\t        async loadImage(path) {\n  135\t            const item = await WORK.get_item(path);\n  136\t            return item?.load ? item.load({ session }) : null;\n  137\t        },\n  138\t        mcpErrors,\n  139\t        llmFor,\n  140\t        imageModel: () => findImageModel(config),\n  141\t        async extTools() {\n  142\t            extTools ??= Promise.all([serviceTools(session), mcpTools({ onError: (s, e) => mcpErrors.push(s.id + ': ' + e.message) })])\n  143\t                .then(([a, b]) => [...a, ...b])\n  144\t                .catch(() => []);\n  145\t            return extTools;\n  146\t        },\n  147\t        /** Инструменты агента (def — субагент или undefined для основного). */\n  148\t        async makeTools(def, depth = 0) {\n  149\t            let all = [...workTools, ...docTools, ...memoryTools, ...webTools, ...connectTools, ...metaTools, ...scheduleTools, ...await env.extTools()];\n  150\t            // не-администратор этих инструментов даже не видит\n  151\t            if (await system())\n  152\t                all.push(...SYSTEM_TOOLS);\n  153\t            if (depth >= MAX_DEPTH)\n  154\t                all = all.filter(t => t.name !== 'task');\n  155\t            if (!def)\n  156\t                return all;\n  157\t            all = all.filter(t => !['ask_user', 'todo_write', 'save_skill', 'connect_service', 'disconnect_service', 'schedule'].includes(t.name));\n  158\t            const spec = def.meta.tools;\n  159\t            // субагенту ОС/сеть — только при явном перечислении (os_*, net_*, shell)\n  160\t            if (!spec || spec === '*' || spec === 'all')\n  161\t                return all.filter(t => !t.system);\n  162\t            if (spec === 'readonly')\n  163\t                return all.filter(t => (t.readonly && !t.system) || t.name === 'task');\n  164\t            const names = Array.isArray(spec) ? spec : String(spec).split(/[\\s,]+/);\n  165\t            return all.filter(t => names.some(n => n === t.name || (n.endsWith('*') && t.name.startsWith(n.slice(0, -1)))));\n  166\t        },\n  167\t        /** system-промпт: правила места, среда, место, пользователь, время, навыки, субагенты. */\n  168\t        async makeSystem(def) {\n  169\t            const parts = [];\n  170\t            if (baseSystem)\n  171\t                parts.push(baseSystem);\n  172\t            if (def?.body)\n  173\t                parts.push('# Твоя роль (субагент ' + def.name + ')\\n' + def.body);\n  174\t            parts.push(ENV_GUIDE);\n  175\t            if (role)\n  176\t                parts.push('Ты работаешь в роли ' + role + ' (выбрана пользователем для этой задачи): файлы пишутся в зону этой роли, права — этой роли'\n  177\t                    + (role === 'ADMIN' ? '.' : '; действия администратора недоступны — если они нужны, скажи пользователю, что задачу нужно запустить в роли ADMIN.'));\n  178\t            if (await system())\n  179\t                parts.push('ОС и сеть: os_* работают с файловой системой СЕРВЕРА WORK вне дерева WORK; net_* — с его локальной сетью. Начинай с os_info/net_info. net_discover ищет объявления, net_scan — порты, net_probe уточняет протокол. Открытый порт не подтверждает вид сервиса. net_register создаёт коннектор в /SERVICES/LAN; назначай доступ через роли класса. Файлы WORK читай и сохраняй WORK-инструментами. shell — полноценная команда ОС с правами процесса, ограничения roots/deny файловых инструментов на неё не распространяются.');\n  180\t            parts.push(await placeBlock(place, session, tz, location));\n  181\t            parts.push(MODE_NOTE[host?.mode] || MODE_NOTE.auto);\n  182\t            if (!def) {\n  183\t                const rm = await safeReadme(place);\n  184\t                if (rm)\n  185\t                    parts.push('# Контракт места (readme)\\n' + clip(rm, 10000));\n  186\t                // память меняется редко, а system собирается на каждом ходе — кэш на минуту\n  187\t                if (!memo || Date.now() - memo.at > 60_000)\n  188\t                    memo = { at: Date.now(), text: await memoryBlock(place, session).catch(() => '') };\n  189\t                if (memo.text)\n  190\t                    parts.push(memo.text);\n  191\t            }\n  192\t            if (skills.size)\n  193\t                parts.push('# Навыки (загружай через skill, если задача подходит)\\n' + listing(skills));\n  194\t            if (!def && agents.size)\n  195\t                parts.push('# Субагенты (поручай через task)\\n' + listing(agents));\n  196\t            if (mcpErrors.length)\n  197\t                parts.push('# Недоступные MCP-серверы\\n' + mcpErrors.map(e => '- ' + e).join('\\n'));\n  198\t            return parts.filter(Boolean).join('\\n\\n');\n  199\t        },\n  200\t        async defaultModel() {\n  201\t            return config.model || DEFAULT_MODEL;\n  202\t        },\n  203\t        /** Память изменена инструментом memory — пересобрать блок на следующем ходе. */\n  204\t        resetMemory() {\n  205\t            memo = null;\n  206\t        },\n  207\t    };\n  208\t    return env;\n  209\t}\n  210\t\n  211\tasync function safeReadme(place) {\n  212\t    try {\n  213\t        const rm = await place?.readme_merged?.();\n  214\t        return String(rm?.text || '').trim();\n  215\t    }\n  216\t    catch {\n  217\t        return '';\n  218\t    }\n  219\t}\n  220\t\n  221\t/** Координаты → «Город, регион, страна» (Nominatim, кэш по ~1 км). */\n  222\tconst PLACES = new Map();\n  223\tasync function resolvePlace(lat, lon) {\n  224\t    const key = (+lat).toFixed(2) + ',' + (+lon).toFixed(2);\n  225\t    if (PLACES.has(key))\n  226\t        return PLACES.get(key);\n  227\t    let place = null;\n  228\t    try {\n  229\t        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=jsonv2&accept-language=ru&zoom=10`, {\n  230\t            headers: { 'User-Agent': 'ODANT-WORK/1.0 (https://odant.org; work@odant.org)' },\n  231\t            signal: AbortSignal.timeout(6000),\n  232\t        });\n  233\t        if (res.ok) {\n  234\t            const a = (await res.json())?.address || {};\n  235\t            place = [a.city || a.town || a.village || a.municipality, a.state, a.country].filter(Boolean).join(', ') || null;\n  236\t        }\n  237\t    }\n  238\t    catch { /* сеть — только координаты */ }\n  239\t    PLACES.set(key, place);\n  240\t    return place;\n  241\t}\n  242\t\n  243\tasync function placeBlock(place, session, tzIn, location) {\n  244\t    const lines = ['# Контекст'];\n  245\t    if (place) {\n  246\t        try {\n  247\t            await place.init;\n  248\t        }\n  249\t        catch { /* без DATA */ }\n  250\t        lines.push('- Место задачи (текущий класс): ' + place.path + (place.DATA?.label ? ' «' + place.DATA.label + '»' : '') + (place.type ? ' [' + place.type + ']' : ''));\n  251\t    }\n  252\t    const user = session?.$user;\n  253\t    if (user && user !== globalThis.WORK) {\n  254\t        lines.push('- Пользователь: ' + (user.DATA?.label || user.label || user.id) + ' (' + (user.path || '/USERS/' + user.id) + ')');\n  255\t        try {\n  256\t            const roles = await place?.roles?.({ session });\n  257\t            if (roles?.length)\n  258\t                lines.push('- Роли пользователя здесь: ' + roles.join(', '));\n  259\t        }\n  260\t        catch { /* нет ролей */ }\n  261\t    }\n  262\t    if (location?.lat != null && location?.lon != null) {\n  263\t        const lat = Number(location.lat).toFixed(4), lon = Number(location.lon).toFixed(4);\n  264\t        const place = await resolvePlace(lat, lon);\n  265\t        lines.push('- Местоположение пользователя: ' + (place ? place + ' (' + lat + ', ' + lon + ')' : lat + ', ' + lon)\n  266\t            + ' — для «здесь/у нас/погода/рядом» используй его (передавай город или координаты в инструменты), не выдумывай другой город');\n  267\t    }\n  268\t    else {\n  269\t        lines.push('- Местоположение пользователя неизвестно (координат нет — один часовой пояс город не определяет). '\n  270\t            + 'Не выводи город из часового пояса и не подставляй его в инструменты: для «здесь/у нас/погода/рядом» сначала узнай город у пользователя (ask_user или вопрос в ответе).');\n  271\t    }\n  272\t    const tz = tzIn || process.env.TZ || Intl.DateTimeFormat().resolvedOptions().timeZone;\n  273\t    const now = new Date();\n  274\t    let local = now.toISOString();\n  275\t    try {\n  276\t        local = now.toLocaleString('ru-RU', { timeZone: tz, dateStyle: 'full', timeStyle: 'short' });\n  277\t    }\n  278\t    catch { /* неизвестная tz */ }\n  279\t    lines.push('- Сейчас: ' + local + ' (' + tz + ')');\n  280\t    return lines.join('\\n');\n  281\t}\n  282\t\n  283\t/**\n  284\t * Разовый запуск (REST: /КЛАСС?prompt&prompt=…): без ленты на диске, без вопросов человеку.\n  285\t * @returns {Promise<{status:string, content:string, items:Array}>}\n  286\t */\n  287\texport async function runOnce({ place, session, prompt, model, agent, mode = 'auto', signal, role } = {}) {\n  288\t    const host = {\n  289\t        mode,\n  290\t        signal,\n  291\t        allowed: new Set(),\n  292\t        save: async () => {},\n  293\t        emit: () => {},\n  294\t    };\n  295\t    const env = await createEnv({ place, session, host, role });\n  296\t    const def = agent ? env.agents.get(agent) : undefined;\n  297\t    if (agent && !def)\n  298\t        throw new Error('нет субагента ' + agent);\n  299\t    const llm = await llmFor(model || def?.meta.model || await env.defaultModel());\n  300\t    const items = [{ id: 'u0', type: 'user', time: Date.now(), content: String(prompt || '') }];\n  301\t    const res = await runLoop({\n  302\t        llm,\n  303\t        system: () => env.makeSystem(def),\n  304\t        items,\n  305\t        tools: await env.makeTools(def, 0),\n  306\t        host,\n  307\t        ctx: { session, place, env, role },\n  308\t        loadImage: env.loadImage,\n  309\t        maxTurns: Number(env.config.maxTurns) || 30,\n  310\t    });\n  311\t    return { status: res.status, content: res.content || '', items };\n  312\t}\n  313\t",
                  "durationMs": 24
                }
              ]
