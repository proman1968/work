                  "path": "/sources/modules/agent/mcp-pool.js",
                  "result": "    1\t/**\n    2\t * Пул stdio MCP-серверов: процесс на конфиг (command+args+env) живёт между вызовами,\n    3\t * initialize — один раз; простой IDLE_MS или смерть процесса — закрыть, следующий вызов поднимет заново.\n    4\t * Вызовы к одному серверу идут по одному каналу параллельно (JSON-RPC id), таймауты — на запрос.\n    5\t * Модуль-синглтон (слои дерева грузятся data:-модулями и пересоздаются — состояние держим здесь).\n    6\t */\n    7\timport { spawn } from 'node:child_process';\n    8\t\n    9\texport const IDLE_MS = 5 * 60_000;\n   10\texport const START_TIMEOUT = 20_000;\n   11\texport const CALL_TIMEOUT = 60_000;\n   12\t\n   13\tconst POOL = new Map();\n   14\t\n   15\tfunction keyOf(cfg) {\n   16\t    return JSON.stringify([cfg.command, cfg.args || [], cfg.env || {}, cfg.cwd || '']);\n   17\t}\n   18\t\n   19\tfunction channel(child) {\n   20\t    let seq = 1;\n   21\t    const pending = new Map();\n   22\t    let buf = '';\n   23\t    let stderr = '';\n   24\t    child.stdout.on('data', chunk => {\n   25\t        buf += String(chunk);\n   26\t        let i;\n   27\t        while ((i = buf.indexOf('\\n')) >= 0) {\n   28\t            const line = buf.slice(0, i).trim();\n   29\t            buf = buf.slice(i + 1);\n   30\t            if (!line)\n   31\t                continue;\n   32\t            let msg;\n   33\t            try {\n   34\t                msg = JSON.parse(line);\n   35\t            }\n   36\t            catch {\n   37\t                continue; // мусор сервера — не протокол\n   38\t            }\n   39\t            if (msg.id != null && pending.has(msg.id) && !msg.method) {\n   40\t                const { resolve, reject } = pending.get(msg.id);\n   41\t                pending.delete(msg.id);\n   42\t                if (msg.error)\n   43\t                    reject(new Error(msg.error.message || JSON.stringify(msg.error)));\n   44\t                else\n   45\t                    resolve(msg.result);\n   46\t            }\n   47\t            else if (msg.id != null && msg.method) {\n   48\t                // запрос сервера (roots/sampling) — честный отказ\n   49\t                write({ jsonrpc: '2.0', id: msg.id, error: { code: -32601, message: 'not supported by work-mcp' } });\n   50\t            }\n   51\t        }\n   52\t    });\n   53\t    child.stderr.on('data', chunk => {\n   54\t        stderr = (stderr + String(chunk)).slice(-2000);\n   55\t    });\n   56\t    const failAll = e => {\n   57\t        for (const { reject } of pending.values())\n   58\t            reject(e);\n   59\t        pending.clear();\n   60\t    };\n   61\t    child.on('error', failAll);\n   62\t    child.on('exit', code => failAll(new Error('процесс MCP завершён (код ' + code + '); stderr: ' + (stderr.trim().slice(-300) || '—'))));\n   63\t    function write(obj) {\n   64\t        child.stdin.write(JSON.stringify(obj) + '\\n');\n   65\t    }\n   66\t    return {\n   67\t        get stderr() { return stderr; },\n   68\t        notify(method, params) {\n   69\t            try {\n   70\t                write({ jsonrpc: '2.0', method, params: params || {} });\n   71\t            }\n   72\t            catch { /* некому слушать */ }\n   73\t        },\n   74\t        request(method, params, timeout = CALL_TIMEOUT) {\n   75\t            return new Promise((resolve, reject) => {\n   76\t                const id = seq++;\n   77\t                const timer = setTimeout(() => {\n   78\t                    pending.delete(id);\n   79\t                    reject(new Error('таймаут ' + timeout + 'мс; stderr: ' + (stderr.trim().slice(-300) || '—')));\n   80\t                }, timeout);\n   81\t                pending.set(id, {\n   82\t                    resolve: v => { clearTimeout(timer); resolve(v); },\n   83\t                    reject: e => { clearTimeout(timer); reject(e); },\n   84\t                });\n   85\t                try {\n   86\t                    write({ jsonrpc: '2.0', id, method, params: params || {} });\n   87\t                }\n   88\t                catch (e) {\n   89\t                    pending.delete(id);\n   90\t                    clearTimeout(timer);\n   91\t                    reject(e);\n   92\t                }\n   93\t            });\n   94\t        },\n   95\t    };\n   96\t}\n   97\t\n   98\tfunction start(key, cfg) {\n   99\t    let command = String(cfg.command);\n  100\t    if (process.platform === 'win32' && /^(npx|npm|pnpm|yarn)$/i.test(command))\n  101\t        command += '.cmd';\n  102\t    const child = spawn(command, (cfg.args || []).map(String), {\n  103\t        env: { ...process.env, ...(cfg.env || {}) },\n  104\t        cwd: cfg.cwd || undefined,\n  105\t        stdio: ['pipe', 'pipe', 'pipe'],\n  106\t        shell: process.platform === 'win32' && /\\.cmd$/i.test(command),\n  107\t        windowsHide: true,\n  108\t    });\n  109\t    const rpc = channel(child);\n  110\t    const entry = { key, child, rpc, calls: 0, timer: null, ready: null, dead: false };\n  111\t    const drop = () => {\n  112\t        entry.dead = true;\n  113\t        clearTimeout(entry.timer);\n  114\t        if (POOL.get(key) === entry)\n  115\t            POOL.delete(key);\n  116\t    };\n  117\t    child.on('exit', drop);\n  118\t    child.on('error', drop);\n  119\t    entry.ready = rpc.request('initialize', {\n  120\t        protocolVersion: '2024-11-05',\n  121\t        capabilities: {},\n  122\t        clientInfo: { name: 'work-mcp', version: '2.0.0' },\n  123\t    }, START_TIMEOUT).then(info => {\n  124\t        rpc.notify('notifications/initialized');\n  125\t        entry.info = info;\n  126\t        return info;\n  127\t    });\n  128\t    entry.ready.catch(() => close(entry));\n  129\t    POOL.set(key, entry);\n  130\t    return entry;\n  131\t}\n  132\t\n  133\tfunction close(entry) {\n  134\t    entry.dead = true;\n  135\t    clearTimeout(entry.timer);\n  136\t    if (POOL.get(entry.key) === entry)\n  137\t        POOL.delete(entry.key);\n  138\t    try {\n  139\t        entry.child.stdin.end();\n  140\t    }\n  141\t    catch { /* закрыт */ }\n  142\t    try {\n  143\t        entry.child.kill();\n  144\t    }\n  145\t    catch { /* мёртв */ }\n  146\t}\n  147\t\n  148\tfunction touch(entry) {\n  149\t    clearTimeout(entry.timer);\n  150\t    entry.timer = setTimeout(() => {\n  151\t        if (!entry.calls)\n  152\t            close(entry);\n  153\t        else\n  154\t            touch(entry);\n  155\t    }, IDLE_MS);\n  156\t    entry.timer.unref?.();\n  157\t}\n  158\t\n  159\t/**\n  160\t * JSON-RPC вызов stdio-сервера из пула.\n  161\t * @param {{command:string,args?:string[],env?:object,cwd?:string}} cfg\n  162\t * @returns {Promise<any>} result (бросает при ошибке)\n  163\t */\n  164\texport async function rpc(cfg, method, params, timeout = CALL_TIMEOUT) {\n  165\t    const key = keyOf(cfg);\n  166\t    let entry = POOL.get(key);\n  167\t    if (!entry || entry.dead)\n  168\t        entry = start(key, cfg);\n  169\t    entry.calls++;\n  170\t    try {\n  171\t        await entry.ready;\n  172\t        return await entry.rpc.request(method, params, timeout);\n  173\t    }\n  174\t    finally {\n  175\t        entry.calls--;\n  176\t        if (!entry.dead)\n  177\t            touch(entry);\n  178\t    }\n  179\t}\n  180\t\n  181\t/** Сколько процессов живо (диагностика/тесты). */\n  182\texport function size() {\n  183\t    return POOL.size;\n  184\t}\n  185\t\n  186\t/** Закрыть все процессы (остановка сервера, тесты). */\n  187\texport function closeAll() {\n  188\t    for (const entry of [...POOL.values()])\n  189\t        close(entry);\n  190\t}\n  191\t\n  192\t/** pid процесса для конфига (тесты). */\n  193\texport function pidOf(cfg) {\n  194\t    return POOL.get(keyOf(cfg))?.child?.pid;\n  195\t}\n  196\t\n  197\tfor (const sig of ['exit', 'SIGINT', 'SIGTERM'])\n  198\t    process.once(sig, () => {\n  199\t        closeAll();\n  200\t        if (sig !== 'exit')\n  201\t            process.exit(0);\n  202\t    });\n  203\t",
