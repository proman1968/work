return true;\n-}\n-\n-// ---------- правила ----------\n-function groupOf(n){ return n<8?'solid':'stripe'; }\n-\n-function endShot(){\n-  const me = turn, opp = 1-turn;\n-  const cuePotted = !cue.alive;\n-  const potted = pottedThisShot.slice();\n-  let foul = cuePotted;\n-  let legal = false;\n-\n-  // брейк: без фола и без сбитого — просто ход\n-  if(broke){\n-    broke=false;\n-    if(potted.length===0 && !foul){\n-      setMsg('Брейк: ход переходит');\n-      turn=opp;\n-    } else {\n-      // назначаем группы по первому легально сбитому\n-      const first = potted.find(n=>n!==8);\n-      if(first && !foul){\n-        groups[me]=groupOf(first); groups[opp]=groupOf(first)==='solid'?'stripe':'solid';\n-        legal=true;\n-      }\n-    }\n-  } else {\n-    const myGroup = groups[me];\n-    const myPotted = potted.filter(n=>n!==8 && myGroup && groupOf(n)===myGroup);\n-    const oppPotted = potted.filter(n=>n!==8 && myGroup && groupOf(n)!==myGroup);\n-    const eightPotted = potted.includes(8);\n-\n-    // проверка: вся ли моя группа снута\n-    const myLeft = balls.filter(b=>b.alive && b.n!==0 && b.n!==8 &&\n-      (groups[me] ? groupOf(b.n)===groups[me] : true)).length;\n-\n-    if(eightPotted){\n-      const myGroupDone = groups[me] &&\n-        !balls.some(b=>b.alive && b.n!==0 && b.n!==8 && groupOf(b.n)===groups[me]);\n-      if(myGroupDone && !foul){ winner=me; state='over';\n-        setMsg('🏆 Игрок '+(me+1)+' выиграл!'); }\n-      else { winner=opp; state='over';\n-        setMsg('🏆 Игрок '+(opp+1)+' выиграл (8-я с фолом/рано)'); }\n-    } else if(foul){\n-      legal=false;\n-    } else if(myPotted.length>0){\n-      legal=true;\n-    } else {\n-      legal=false;\n-    }\n-  }\n-\n-  // фол: шар в руке\n-  const foulNow = cuePotted || (potted.length===0 && !broke && !legal && !foul);\n-  if(cuePotted){\n-    cue.alive=true; cue.vx=0; cue.vy=0;\n-    state='place';\n-    setMsg('Фол! Поставьте белый шар');\n-  } else if(!legal){\n-    turn=opp;\n-    st