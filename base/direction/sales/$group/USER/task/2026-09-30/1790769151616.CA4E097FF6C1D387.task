      "tools": [
        {
          "id": "chatcmpl-tool-b40dbb3c81c1cdeb",
          "name": "append",
          "args": {
            "content": "\n// ---------- физика ----------\nfunction inPocket(b){\n  for(const p of pockets){\n    const dx=b.x-p.x, dy=b.y-p.y;\n    if(dx*dx+dy*dy < PR2*PR2) return true;\n  }\n  return false;\n}\n\nfunction step(dt){\n  for(const b of balls){\n    if(!b.alive) continue;\n    b.x += b.vx*dt; b.y += b.vy*dt;\n    const f = Math.exp(-FRICTION*dt);\n    b.vx*=f; b.vy*=f;\n    if(Math.hypot(b.vx,b.vy) < STOP){ b.vx=0; b.vy=0; }\n  }\n  for(const b of balls){\n    if(!b.alive) continue;\n    if(inPocket(b)){\n      b.alive=false; b.vx=0; b.vy=0;\n      if(b.n!==0) pottedThisShot.push(b.n);\n    }\n  }\n  for(const b of balls){\n    if(!b.alive) continue;\n    if(b.x < PL+R){ b.x=PL+R; b.vx=-b.vx*0.9; }\n    if(b.x > PR-R){ b.x=PR-R; b.vx=-b.vx*0.9; }\n    if(b.y < PT+R){ b.y=PT+R; b.vy=-b.vy*0.9; }\n    if(b.y > PB-R){ b.y=PB-R; b.vy=-b.vy*0.9; }\n  }\n  for(let i=0;i<balls.length;i++){\n    const a=balls[i]; if(!a.alive) continue;\n    for(let j=i+1;j<balls.length;j++){\n      const c=balls[j]; if(!c.alive) continue;\n      let dx=c.x-a.x, dy=c.y-a.y;\n      let d=Math.hypot(dx,dy);\n      if(d===0){ d=0.01; dx=0.01; }\n      if(d < R*2){\n        const nx=dx/d, ny=dy/d;\n        const overlap=(R*2-d)/2;\n        a.x-=nx*overlap; a.y-=ny*overlap;\n        c.x+=nx*overlap; c.y+=ny*overlap;\n        const rvx=c.vx-a.vx, rvy=c.vy-a.vy;\n        const vn=rvx*nx+rvy*ny;\n        if(vn<0){\n          const imp=-vn;\n          a.vx-=imp*nx; a.vy-=imp*ny;\n          c.vx+=imp*nx; c.vy+=imp*ny;\n        }\n      }\n    }\n  }\n}\n\nfunction allStopped(){\n  for(const b of balls){\n    if(b.alive && (b.vx!==0 || b.vy!==0)) return false;\n  }\n  return true;\n}\n\n// ---------- правила ----------\nfunction groupOf(n){ return n<8?'solid':'stripe'; }\n\nfunction endShot(){\n  const me = turn, opp = 1-turn;\n  const cuePotted = !cue.alive;\n  const potted = pottedThisShot.slice();\n  let foul = cuePotted;\n  let legal = false;\n\n  if(broke){\n    broke=false;\n    if(potted.length===0 && !foul){\n      setMsg('Брейк: ход переходит');\n      turn=opp;\n    } else {\n      const first = potted.find(n=>n!==8);\n      if(first && !foul){\n        groups[me]=groupOf(first);\n        groups[opp]=groupOf(first)==='solid'?'stripe':'solid';\n        legal=true;\n      }\n    }\n  } else {\n    const myGroup = groups[me];\n    const myPotted = potted.filter(n=>n!==8 && myGroup && groupOf(n)===myGroup);\n    const eightPotted = potted.includes(8);\n\n    if(eightPotted){\n      const myGroupDone = groups[me] &&\n        !balls.some(b=>b.alive && b.n!==0 && b.n!==8 && groupOf(b.n)===groups[me]);\n      if(myGroupDone && !foul){ winner=me; state='over';\n        setMsg('🏆 Игрок '+(me+1)+' выиграл!'); }\n      else { winner=opp; state='over';\n        setMsg('🏆 Игрок '+(opp+1)+' выиграл (8-я с фолом/рано)'); }\n    } else if(foul){\n      legal=false;\n    } else if(myPotted.length>0){\n      legal=true;\n    } else {\n      legal=false;\n    }\n  }\n\n  if(cuePotted){\n    cue.alive=true; cue.vx=0; cue.vy=0;\n    state='place';\n    setMsg('Фол! Поставьте белый шар');\n  } else if(!legal){\n    turn=opp;\n    state='aim';\n    setMsg('Ход переходит Игроку '+(turn+1));\n  } else {\n    state='aim';\n    setMsg('Ещё ход Игрока '+(turn+1));\n  }\n  pottedThisShot=[];\n  updateUI();\n}\n\n// ---------- отрисовка ----------\nfunction drawTable(){\n  ctx.fillStyle='#5a3a1e';\n  ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='#0f6b3a';\n  ctx.fillRect(BORDER,BORDER,W-2*BORDER,H-2*BORDER);\n  ctx.fillStyle='#0a0a0a';\n  for(const p of pockets){\n    ctx.beginPath(); ctx.arc(p.x,p.y,PR2,0,7); ctx.fill();\n  }\n  ctx.fillStyle='rgba(255,255,255,.25)';\n  ctx.beginPath();\n  ctx.arc(PL+(PR-PL)*0.72,(PT+PB)/2,3,0,7); ctx.fill();\n}\n\nfunction drawBall(b){\n  if(!b.alive) return;\n  ctx.save();\n  ctx.beginPath();\n  ctx.arc(b.x+2,b.y+3,R,0,7);\n  ctx.fillStyle='rgba(0,0,0,.3)'; ctx.fill();\n  ctx.beginPath(); ctx.arc(b.x,b.y,R,0,7);\n  ctx.fillStyle=b.color; ctx.fill();\n  if(b.type==='stripe'){\n    ctx.save();\n    ctx.beginPath(); ctx.arc(b.x,b.y,R,0,7); ctx.clip();\n    ctx.fillStyle='#fff';\n    ctx.fillRect(b.x-R, b.y-R*0.45, R*2, R*0.9);\n    ctx.restore();\n  }\n  ctx.beginPath(); ctx.arc(b.x,b.y,R*0.55,0,7);\n  ctx.fillStyle='#fff'; ctx.fill();\n  ctx.fillStyle='#111';\n  ctx.font='bold '+(R*0.8)+'px system-ui';\n  ctx.textAlign='center'; ctx.textBaseline='middle';\n  ctx.fillText(b.n, b.x, b.y+0.5);\n  ctx.beginPath(); ctx.arc(b.x-R*0.35,b.y-R*0.35,R*0.28,0,7);\n  ctx.fillStyle='rgba(255,255,255,.5)'; ctx.fill();\n  ctx.restore();\n}\n\nfunction drawAim(){\n  if(state!=='aim' && state!=='charging') return;\n  if(!cue.alive) return;\n  const dx=mouse.x-cue.x, dy=mouse.y-cue.y;\n  const d=Math.hypot(dx,dy)||1;\n  const nx=dx/d, ny=dy/d;\n  ctx.save();\n  ctx.setLineDash([6,6]);\n  ctx.strokeStyle='rgba(255,255,255,.7)';\n  ctx.lineWidth=2;\n  ctx.beginPath();\n  ctx.moveTo(cue.x,cue.y);\n  ctx.lineTo(cue.x+nx*400, cue.y+ny*400);\n  ctx.stroke();\n  ctx.setLineDash([]);\n  if(state==='charging'){\n    const len=40+power*120;\n    ctx.strokeStyle='#ffd54a'; ctx.lineWidth=4;\n    ctx.beginPath();\n    ctx.moveTo(cue.x,cue.y);\n    ctx.lineTo(cue.x+nx*len, cue.y+ny*len);\n    ctx.stroke();\n  }\n  ctx.restore();\n}\n\nfunction render(){\n  drawTable();\n  for(const b of balls) if(b.n!==0) drawBall(b);\n  drawBall(cue);\n  drawAim();\n}\n\n// ---------- ввод ----------\nfunction toCanvas(e){\n  const r=cv.getBoundingClientRect();\n  const cx=(e.touches?e.touches[0].clientX:e.clientX);\n  const cy=(e.touches?e.touches[0].clientY:e.clientY);\n  return {x:(cx-r.left)*(W/r.width), y:(cy-r.top)*(H/r.height)};\n}\n\nfunction onMove(e){ mouse=toCanvas(e); }\n\nfunction onDown(e){\n  e.preventDefault();\n  mouse=toCanvas(e);\n  if(state==='place'){\n    if(canPlace(mouse.x,mouse.y)){\n      cue.x=mouse.x; cue.y=mouse.y; cue.alive=true;\n      state='aim'; setMsg('Ход Игрока '+(turn+1));\n    }\n    return;\n  }\n  if(state==='aim'){\n    state='charging'; power=0; chargeDir=1;\n  }\n}\n\nfunction onUp(e){\n  if(state==='charging'){\n    const dx=mouse.x-cue.x, dy=mouse.y-cue.y;\n    const d=Math.hypot(dx,dy)||1;\n    const v=power*MAXV;\n    cue.vx=dx/d*v; cue.vy=dy/d*v;\n    state='moving';\n    setMsg('…');\n  }\n}\n\nfunction canPlace(x,y){\n  if(x<PL+R||x>PR-R||y<PT+R||y>PB-R) return false;\n  for(const b of balls){\n    if(!b.alive||b.n===0) continue;\n    if(Math.hypot(b.x-x,b.y-y) < R*2+1) return false;\n  }\n  return true;\n}\n\ncv.addEventListener('mousemove',onMove);\ncv.addEventListener('mousedown',onDown);\nwindow.addEventListener('mouseup',onUp);\ncv.addEventListener('touchstart',onDown,{passive:false});\ncv.addEventListener('touchmove',e=>{e.preventDefault();onMove(e);},{passive:false});\nwindow.addEventListener('touchend',onUp);\ndocument.getElementById('new').addEventListener('click',resetGame);\n\n// ---------- цикл ----------\nlet last=performance.now();\nfunction loop(now){\n  const dt=Math.min(0.032,(now-last)/1000); last=now;\n  if(state==='charging'){\n    power+=chargeDir*dt*1.4;\n    if(power>=1){power=1;chargeDir=-1;}\n    if(power<=0){power=0;chargeDir=1;}\n    updateUI();\n  }\n  if(state==='moving'){\n    const sub=4;\n    for(let i=0;i<sub;i++) step(dt/sub);\n    if(allStopped()) endShot();\n  }\n  render();\n  requestAnimationFrame(loop);\n}\n\nresetGame();\nrequestAnimationFrame(loop);\n</script>\n</body>\n</html>\n",
            "path": "/BASE/direction/sales/$group/USER/text/Бильярд.html"
