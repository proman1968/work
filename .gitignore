node_modules/

# Secrets and local config
/#system/mail.json
/#system/server.json
/#system/vapid_keys.json
/#system/node-key.json
/#system/settings.json
/#system/os.json
/#system/lan/
.env
**/#secret/
**/#system/email.json

# Local user profiles (runtime data)
USERS/*/
!USERS/$users/

# Runtime data (keep structure, ignore volatile content)
**/logs/
**/.RAG/
**/*.webm
**/history/
# рабочие зоны классов — только внутри $-метапапок (учёту 4.4: широкое **/work/ съедало
# код sources/modules/agent/tools/work/); вне метапапок work/ — код, не данные
**/$*/work/
# Зоны ролей и данных — только внутри метапапки ($тип/DATA, $тип/USER…); одноимённые классы (/DATA) публикуются
**/$*/DATA/
**/$*/ADMIN/
**/$*/USER/
**/$*/BOSS/

# Progress snapshots (mirror of WORK history pattern)
.progress.md/history/
# OS / IDE
.DS_Store
Thumbs.db
*.log
.svn/

# Python venv / models (локальные модели; веса качаются отдельно, см. README модели)
sources/modules/*/.venv/

# Large ML model weights (download separately)
torus/binnet/models/

!*.js

.vscode/tasks.json
/#system/oauth/

# ��������� ������� ������� (������ �� ������, RAG)
/.index/

# Data organization DB (source of truth, backup separately)
/.data/
