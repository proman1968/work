# Исключения при публикации пакета work в npm:
# 1. Исключаем torus и отдельное приложение лицензионного сервера (оно публикуется своим пакетом из license-server/)
/torus/
/torus/**
/license-server/
/license-server/**

# 2. Секреты, системные ключи, лицензии и локальные настройки узла
# (эталонные файлы #system/certs/*, #system/sandbox.json, #system/package-manifest.json и *.example сохраняются в пакете)
/#system/mail.json
/#system/server.json
/#system/vapid_keys.json
/#system/node-key.json
/#system/settings.json
/#system/os.json
/#system/run.pid
/#system/auto-update.json
/#system/updates/
/#system/lan/
/#system/oauth/
/#system/license*.json
/#system/owner-token.json
**/#system/email.json
**/#system/work.db*
**/#secret/
.env
.env.*

# 3. Тяжёлые веса локальных моделей, датасеты и адаптеры LoRA
# В чистой поставке /MODELS/Local пустой (только системная метапапка $provider), а внутренний контур разработчика /MODELS/odant исключён
/MODELS/odant/
/MODELS/odant/**
/MODELS/Halogen/
/MODELS/Halogen/**
/MODELS/Local/*/
!/MODELS/Local/$provider/
!/MODELS/Local/$provider/**
**/#weights/
**/#datasets/
**/#adapters/
**/#runtime/
**/#cache/
**/*.safetensors
**/*.gguf
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
sources/modules/*/.venv/

# 4. Локальные базы данных, индексы, логи, организации и сессии пользователей
# ВАЖНО: только корневые /data/ и /.data/, чтобы НЕ зацепить исходники sources/data/!
/data/
/data/**
/.data/
/.data/**
**/*.db
**/*.db-wal
**/*.db-shm
/.index/
**/.RAG/
**/logs/
**/history/
**/$*/work/
**/$*/task/
**/$*/call/
# В чистой поставке в /ORGANIZATIONS публикуется только системная метапапка $domain (организации создаются пользователем из BASE_TEMPLATE)
/ORGANIZATIONS/*/
!/ORGANIZATIONS/$domain/
!/ORGANIZATIONS/$domain/**
/$server/task/
/$server/xlsx/
/$server/docx/
/$server/pdf/
/$server/pptx/
**/ADMIN/task/
**/ADMIN/image/
**/ADMIN/text/
**/ADMIN/xlsx/
**/ADMIN/docx/
**/USER/task/
**/USER/call/
**/USER/text/
**/BOSS/task/
.progress.md/
/USERS/*/
!/USERS/$users/
test_tts.wav

# 5. Разработка, тесты и служебные каталоги VCS
/.git/
/.svn/
/.vscode/
/tests/
/docs/
.DS_Store
Thumbs.db
*.log
*.tgz
current_session.json
